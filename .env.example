# ==============================================================================
# Crewlane Environment Configuration Example
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# Core Application & Multi-Tenancy
NODE_ENV=development
PORT=3000
ROOT_DOMAIN=localhost:3000
APP_PROTOCOL=http
PUBLIC_SIGNUP=true
LOG_LEVEL=info

# Better-Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789

# Data Encryption Key (AES-256 key: 32 bytes base64 encoded)
CREWLANE_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=

# Database Connections (PostgreSQL 16 with pgvector)
DATABASE_ADMIN_URL=postgres://crewlane:crewlane@localhost:5432/crewlane
DATABASE_URL=postgres://crewlane_app:app-dev-password@localhost:5432/crewlane
WORKER_DATABASE_URL=postgres://crewlane_worker:worker-dev-password@localhost:5432/crewlane
APP_DB_PASSWORD=app-dev-password
WORKER_DB_PASSWORD=worker-dev-password
DATABASE_POOL_MAX=10

# Object Storage (S3 / MinIO)
STORAGE_DRIVER=local
STORAGE_DIR=.storage
# For S3 / MinIO:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=crewlane
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=crewlane
# AWS_SECRET_ACCESS_KEY=crewlane-minio

# Worker & Background Tasks
WORKER_PORT=8081
WORKER_POLL_MS=1000
WORKER_SCHEDULER_MS=60000
CREWLANE_WORKER_AUTOSTART=true
METRICS_TOKEN=dev-metrics-token

# Ownmind In-House Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
